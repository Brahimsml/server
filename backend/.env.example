EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change-me

# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=pc_store
DB_PORT=3307

# Website address (used for links in emails, e.g. https://megatech.com)
SITE_URL=http://localhost:3000

# "Continue with Google" (optional). The same Client ID goes in frontend/.env as REACT_APP_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Delivery fee added to every order, in dollars (default 5)
DELIVERY_FEE=5

# Where new-order alerts go (default: EMAIL_USER, the shop's own address)
ADMIN_NOTIFY_EMAIL=

# 2-step admin sign-in: after the right password, a code is emailed here
# (default: ADMIN_NOTIFY_EMAIL, else EMAIL_USER). Use an inbox only you can open.
ADMIN_CODE_EMAIL=
# Set to off only if emails can't be sent and you're locked out (then turn it back on)
ADMIN_TWO_STEP=

# Online only: set NODE_ENV=production, and TRUST_PROXY=1 when the host puts a proxy in front
# (most do: Render, Railway, Heroku, Nginx), so request limits see each visitor's real address
NODE_ENV=
TRUST_PROXY=
